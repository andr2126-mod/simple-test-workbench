@startuml domain
!include https://raw.githubusercontent.com/andr2126-mod/simple-test-workbench/main/_style.puml
title Система автоматического тестирования: модель предметной области
hide circle

package "management" as M <<управление тестовыми активами>> {
  class TestSuite {
    +id: UUID
    +name: String
    +tags: String[]
  }
  class TestCase {
    +id: UUID
    +title: String
    +isFlaky: Boolean
    +retryCount: int
    -version: int
  }
}

package "execution" as E <<прогоны и результаты>> {
  class Run {
    +id: UUID
    +startedAt: DateTime
    +finishedAt: DateTime
    +status: RunStatus
    +triggerSource: TriggerSource
    +commitSha: String
    +errorReason: String
    -idempotencyKey: String
    +computeStatus(): RunStatus
    +retry(): Run
  }
  class TestResult {
    +id: UUID
    +status: ResultStatus
    +durationMs: int
    +environment: String
    +logsUrl: String
  }
  class Report {
    +id: UUID
    +generatedAt: DateTime
    +summaryUrl: String
  }
  class FlakyPolicy {
    +windowN: int
    +minFailures: int
    +evaluate(results: TestResult[]): Boolean
  }
  enum RunStatus {
    PENDING
    PASSED
    FAILED
    ERROR
    CANCELLED
  }
  enum ResultStatus {
    PASSED
    FAILED
    ERROR
    SKIPPED
  }
  enum TriggerSource {
    MANUAL
    CI_EVENT
    SCHEDULE
  }
}

package "integration" as I <<внешние интеграции>> {
  abstract class Integration {
    +id: UUID
    -encryptedToken: String
    {abstract} +authenticate(token: String): Boolean
  }
  class CIIntegration {
    +webhookUrl: String
  }
  class BranchBinding {
    +branch: String
  }
}

' --- Обобщение ---
CIIntegration --|> Integration

' --- Агрегация и композиция ---
TestSuite "0..*" o-- "1..*" TestCase : содержит
Run "1" *-- "0..*" TestResult : включает

' --- Ассоциации (кратности везде; направление - в сторону пакета management) ---
Run "0..*" --> "1" TestSuite : относится к набору
TestResult "0..*" --> "1" TestCase : относится к
Report "0..1" --> "1" Run : строится по
Run "0..*" --> "0..1" Run : повтор исходного
CIIntegration "1" -- "0..*" BranchBinding : содержит привязки
BranchBinding "0..*" --> "1" TestSuite : привязывает набор

' --- Зависимости ---
FlakyPolicy ..> TestResult : <<use>>
FlakyPolicy ..> TestCase : <<оценивает>>

' --- Зависимости пакетов (ациклично: из management ссылок наружу нет) ---
I ..> M : <<use>>
E ..> M : <<use>>
@enduml
