@startuml draft-usecase
!include https://raw.githubusercontent.com/andr2126-mod/simple-test-workbench/main/_style.puml
left to right direction
skinparam packageStyle rectangle

actor "Тестировщик" as Tester
actor "Разработчик" as Dev
actor "CI-сервер" as CI

rectangle "Система автоматического тестирования" {
  usecase "Запустить набор тестов" as UC1
  usecase "Просмотреть отчёт по прогону" as UC2
  usecase "Просмотреть историю прогонов" as UC3
  usecase "Выявить и маркировать флаки-тесты" as UC4
  usecase "Настроить интеграцию с CI" as UC5
  usecase "Триггер прогона из CI" as UC6
}

Tester --> UC1
Tester --> UC2
Tester --> UC3
Tester --> UC4
Dev --> UC2
Dev --> UC3
Dev --> UC5
CI --> UC6
UC6 ..> UC1 : <<include>>
UC1 ..> UC4 : <<include>>
@enduml